{
  "name": "midnight-counter-dapp",
  "version": "1.0.0",
  "type": "module",
  "description": "A privacy-preserving counter dApp built on Midnight Network",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "cd contracts && npx @midnight-ntwrk/compact-cli@latest compile counter.compact managed/counter",
    "test": "jest",
    "deploy:contract": "npx tsx scripts/deploy.ts",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
